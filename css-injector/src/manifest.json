{
  "manifest_version": 3,
  "name": "CSS Injector",
  "version": "1.0",
  "description": "Apply your own CSS files to specific websites.",
  "permissions": ["storage", "scripting", "tabs", "webNavigation"],
  "host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}